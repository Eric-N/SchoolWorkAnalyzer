/**
 * What the PC (local AI) version knew when the project moved back to Apps
 * Script on 2026-11-05: the current homework sheet(s), recent spelling
 * batches (so a final test is still recognised and replies to the PC's
 * emails still work), which of those emails were already answered, and the
 * needs-help practice words. The data itself is in SeedData.gs, generated by
 * tools/make_seed.py and kept out of git; without it this does nothing.
 *
 * setupProject() applies it once; the SEEDED_FROM_LOCAL Script Property
 * stops it from being applied twice.
 */

function spoSeedFromLocal_() {
  const props = spoProps_();
  if (props.getProperty('SEEDED_FROM_LOCAL')) return;
  // SeedData.gs only exists on the PC that ran the old version (it's not in git).
  if (typeof SPO_LOCAL_SEED === 'undefined') return;
  const seed = SPO_LOCAL_SEED;

  const history = spoManifestHistory_();
  seed.manifests.forEach(m => {
    if (!history.some(h => h.week_date_text === m.week_date_text && h.scan_date === m.scan_date)) history.push(m);
  });
  history.sort((a, b) => String(a.scan_date).localeCompare(String(b.scan_date)));
  spoStoreManifestHistory_(history);

  const now = new Date().toISOString();
  const haveBatch = spoSpellingBatches_().map(b => b.id);
  seed.batches.forEach(b => {
    if (haveBatch.indexOf(b.id) >= 0) return;
    spoAppendTextRow_(SPO_SHEETS.SPELLING_BATCHES,
      [b.id, b.scan_date, 'pc:' + b.source_name, b.source_name, JSON.stringify(b.words), '', now, now]);
  });
  seed.emails.forEach(e => spoRecordEmail_('', e.rfc_message_id, e.kind, e.batch_id, '', e.summary));
  seed.replies.forEach(r => spoRecordEmail_('', r.rfc_message_id, 'reply-handled', '', '', r.summary));
  seed.practice.forEach(p => spoAddOrRefreshSpellingWord_(p.word, p.first_seen, 'pc'));

  props.setProperty('SEEDED_FROM_LOCAL', now);
  console.log(`Carried over from the PC version: ${seed.manifests.length} homework sheet(s), ` +
    `${seed.batches.length} spelling batch(es), ${seed.replies.length} handled repl(ies), ` +
    `${seed.practice.length} practice word(s).`);
}
